@using System.Globalization
@using Bodeglook.Models
@{
    ViewData["Title"] = "Inicio";
    List<TarjetaRestaurante> lugares = ViewBag.Lugares;
}

@section Estilos {
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
}

<!-- Hero -->
<section class="hero">
    <div class="hero-texto">
        <span class="chip chip-naranja">
            <img src="~/img/icono-pin-chip.svg" width="18" height="18" alt="" />
            Red social gastronómica
        </span>
        <h1>Elegí dónde comer con tus amigos, más fácil</h1>
        <p>Organizá la salida, votá el lugar y leé reseñas de gente real. Con filtros dietarios en los que sí podés confiar.</p>
        <div class="hero-botones">
            <a class="boton boton-primario boton-grande" href="/Cuenta/Registro">Registrarme</a>
            <a class="boton boton-secundario" href="/Cuenta/IniciarSesion">Ya tengo cuenta</a>
        </div>
    </div>
    <div class="hero-foto">
        <img src="~/img/hero-index.jpg" alt="Dos amigos mirando Bodeglook en el celular" />
        <div class="tarjeta-flotante">
            <span class="icono-circulo">
                <img src="~/img/icono-estrella-tarjeta.svg" width="24" height="24" alt="" />
            </span>
            <div class="tarjeta-flotante-textos">
                <span class="tarjeta-flotante-nombre">Vinos del Sur</span>
                <span class="tarjeta-flotante-detalle">Bar de vinos · ★ 4.8 · Sin TACC</span>
            </div>
        </div>
    </div>
</section>

<!-- Beneficios -->
<section class="beneficios">
    <div class="fila-tarjetas">
        <div class="tarjeta">
            <span class="icono-circulo">
                <img src="~/img/icono-buscar.svg" width="28" height="28" alt="" />
            </span>
            <h3>Descubrí</h3>
            <p>Reseñas de toda la comunidad según tus preferencias.</p>
        </div>
        <div class="tarjeta">
            <span class="icono-circulo">
                <img src="~/img/icono-usuarios.svg" width="28" height="28" alt="" />
            </span>
            <h3>Disfrutá</h3>
            <p>Disfrutá de las experiencias con amigos, en el restaurante que más le conviene a todos.</p>
        </div>
        <div class="tarjeta">
            <span class="icono-circulo">
                <img src="~/img/icono-estrella-beneficio.svg" width="28" height="28" alt="" />
            </span>
            <h3>Reseñá</h3>
            <p>Compartí tus experiencias dejando tu opinión sincera sobre el lugar.</p>
        </div>
    </div>
</section>

<!-- Cómo funciona -->
<section class="seccion seccion-crema como-funciona">
    <div class="encabezado-seccion">
        <span class="chip chip-naranja">Cómo funciona</span>
        <h2>Organizar una salida nunca fue tan fácil</h2>
        <p>Tres pasos para pasar del grupo de chat eterno a la mesa reservada.</p>
    </div>
    <div class="fila-tarjetas">
        <div class="tarjeta">
            <span class="icono-circulo icono-circulo-naranja">1</span>
            <h3>Armá el plan</h3>
            <p>Creá un grupo con tus amigos y proponé los lugares que les tienten.</p>
        </div>
        <div class="tarjeta">
            <span class="icono-circulo icono-circulo-naranja">2</span>
            <h3>Voten entre todos</h3>
            <p>Cada uno vota su favorito y ven al instante si hay consenso.</p>
        </div>
        <div class="tarjeta">
            <span class="icono-circulo icono-circulo-naranja">3</span>
            <h3>Salgan a disfrutar</h3>
            <p>Confirmen el lugar ganador, reserven y después cuenten qué tal estuvo.</p>
        </div>
    </div>
</section>

<!-- Lugares recomendados -->
<section class="seccion lugares">
    <div class="lugares-encabezado">
        <div>
            <h2>Lugares que recomienda la comunidad</h2>
            <p>Bodegas, parrillas y restaurantes con reseñas de gente que fue de verdad.</p>
        </div>
        <a class="boton boton-secundario" href="/Cuenta/IniciarSesion">Explorar restaurantes</a>
    </div>

    @* Los 4 mejor puntuados, igual que "Recomendado para vos". Llevan al Detalle (si no hay sesión, pide iniciarla). *@
    <div class="grilla-lugares">
        @foreach (TarjetaRestaurante lugar in lugares)
        {
            <a class="tarjeta-lugar" href="/Restaurantes/Detalle/@lugar.Id">
                <div class="tarjeta-lugar-foto">
                    <img src="@lugar.Foto" alt="@lugar.Nombre" />
                    <span class="tarjeta-lugar-favorito">
                        <img src="~/img/icono-corazon.svg" width="18" height="18" alt="" />
                    </span>
                </div>
                <div class="tarjeta-lugar-titulo">
                    <span class="tarjeta-lugar-nombre">@lugar.Nombre</span>
                    @if (lugar.Puntaje != null)
                    {
                        <span class="puntaje">★ @lugar.Puntaje.Value.ToString("0.0", CultureInfo.InvariantCulture)</span>
                    }
                </div>
                <div class="tarjeta-lugar-detalle">
                    <span class="chip chip-crema chip-categoria">@lugar.Categoria</span>
                    <span class="ubicacion">
                        <img src="~/img/icono-pin.svg" width="16" height="16" alt="" />
                        @lugar.Barrio
                    </span>
                </div>
            </a>
        }
    </div>
</section>

<!-- Reseñas reales -->
<section class="seccion seccion-negra resenas-reales">
    <div class="resenas-reales-texto">
        <span class="chip chip-naranja">Sin canjes</span>
        <h2>Reseñas reales, de gente como vos</h2>
        <p>En Bodeglook nadie cobra por opinar: no hay canjes ni publicidad disfrazada. Solo experiencias de la comunidad, para que elijas tranquilo.</p>
        <p class="subtitulo-dietarios">Filtros dietarios en los que podés confiar</p>
        <div class="chips-dietarios">
            <span class="chip chip-crema">Sin TACC</span>
            <span class="chip chip-crema">Vegetariano</span>
            <span class="chip chip-crema">Vegano</span>
            <span class="chip chip-crema">Sin lactosa</span>
        </div>
    </div>

    @* DATOS DE PRUEBA: estas 3 reseñas están copiadas del Figma. Después salen de la base. *@
    <div class="resenas-lista">
        <div class="tarjeta-resena">
            <div class="resena-autor">
                <span class="avatar">JP</span>
                <div class="resena-datos">
                    <span class="resena-nombre">Julián Pérez</span>
                    <span class="resena-fecha">Hace 2 días</span>
                </div>
                <div class="estrellas">
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                </div>
            </div>
            <p class="resena-texto">El patio es hermoso y la tabla de quesos con el malbec fue un golazo. Atención de 10.</p>
        </div>
        <div class="tarjeta-resena">
            <div class="resena-autor">
                <span class="avatar">MG</span>
                <div class="resena-datos">
                    <span class="resena-nombre">Martina G.</span>
                    <span class="resena-fecha">Hace 1 semana</span>
                </div>
                <div class="estrellas">
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-vacia.svg" width="16" height="16" alt="" />
                </div>
            </div>
            <p class="resena-texto">Muy buena opción sin TACC, nos cuidaron mucho. Recomiendo reservar con tiempo.</p>
        </div>
        <div class="tarjeta-resena">
            <div class="resena-autor">
                <span class="avatar">NR</span>
                <div class="resena-datos">
                    <span class="resena-nombre">Nico Ramos</span>
                    <span class="resena-fecha">Hace 3 semanas</span>
                </div>
                <div class="estrellas">
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                    <img src="~/img/icono-estrella-llena.svg" width="16" height="16" alt="" />
                </div>
            </div>
            <p class="resena-texto">Fuimos en grupo y se adaptaron a todos. Volvemos seguro.</p>
        </div>
    </div>
</section>

<!-- Llamado final -->
<section class="seccion">
    <div class="llamado-final">
        <div>
            <h2>¿Con quién salís este finde?</h2>
            <p>Creá tu cuenta gratis y armá tu primer plan en minutos.</p>
        </div>
        <a class="boton boton-secundario" href="/Cuenta/Registro">Crear mi cuenta</a>
    </div>
</section>
