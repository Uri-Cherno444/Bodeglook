@using Bodeglook.Models
@{
    ViewData["Title"] = "Inicio";
    ViewData["Pestaña"] = "Inicio";
    List<TarjetaRestaurante> recomendados = ViewBag.Recomendados;
    List<TarjetaRestaurante> favoritos = ViewBag.Favoritos;
}

@section Estilos {
    <link rel="stylesheet" href="~/css/inicio.css" asp-append-version="true" />
}

<div class="inicio">
    <!-- Banner -->
    <section class="banner">
        <div class="banner-texto">
            <p class="banner-saludo">Hola, @ViewBag.PrimerNombre</p>
            <h1>¿Con quién salís esta semana?</h1>
            <p class="banner-descripcion">Armá un plan, sumá a tus amigos y votá el lugar entre todos.</p>
            <div class="banner-botones">
                <a class="boton boton-primario" href="/Planes/NuevoPlan">Crear un plan</a>
                <a class="boton boton-secundario" href="/Restaurantes/Descubrir">Explorar restaurantes</a>
            </div>
        </div>

        @* DATOS DE PRUEBA: los contadores son fijos. Su lógica es del próximo sprint. *@
        <div class="banner-resumen">
            <div class="dato">
                <img src="~/img/icono-calendario.svg" width="24" height="24" alt="" />
                <span class="dato-numero">2</span>
                <span class="dato-texto">planes en votación</span>
            </div>
            <div class="dato">
                <img src="~/img/icono-usuarios-chico.svg" width="24" height="24" alt="" />
                <span class="dato-numero">3</span>
                <span class="dato-texto">amigos nuevos</span>
            </div>
        </div>
    </section>

    @* DATOS DE PRUEBA: los chips son fijos y todavía no filtran. Su lógica es del próximo sprint. *@
    <div class="filtros-rapidos">
        <span class="chip chip-filtro chip-activo">Todos</span>
        <span class="chip chip-filtro chip-crema">Vinotecas</span>
        <span class="chip chip-filtro chip-crema">Parrillas</span>
        <span class="chip chip-filtro chip-crema">Italiana</span>
        <span class="chip chip-filtro chip-crema">Japonesa</span>
        <span class="chip chip-filtro chip-crema">Sin TACC</span>
        <span class="chip chip-filtro chip-crema">Vegetariano</span>
    </div>

    <!-- Recomendado para vos: por ahora, los 4 mejor puntuados -->
    <section class="seccion-lugares">
        <div class="seccion-lugares-encabezado">
            <h2>Recomendado para vos</h2>
            <a class="ver-todo" href="/Restaurantes/Descubrir">Ver todo</a>
        </div>
        <div class="grilla-lugares">
            @foreach (TarjetaRestaurante lugar in recomendados)
            {
                @await Html.PartialAsync("_TarjetaLugar", lugar)
            }
        </div>
    </section>

    <!-- Tus favoritos: los de la tabla Favoritos del usuario de la sesión -->
    <section class="seccion-lugares">
        <div class="seccion-lugares-encabezado">
            <h2>Tus favoritos</h2>
            <a class="ver-todo" href="/Restaurantes/Descubrir">Ver todo</a>
        </div>
        <div class="grilla-lugares" id="grillaFavoritos" aria-live="polite">
            @foreach (TarjetaRestaurante lugar in favoritos)
            {
                @await Html.PartialAsync("_TarjetaLugar", lugar)
            }
        </div>
        <p class="sin-favoritos" id="sinFavoritos" hidden="@(favoritos.Count > 0)">
            Todavía no guardaste favoritos. <a href="/Restaurantes/Descubrir">Ir a Descubrir</a>
        </p>
    </section>
</div>

@section Scripts {
    <script src="~/js/inicio.js" asp-append-version="true"></script>
}
