@using Bodeglook.Models
@{
    ViewData["Title"] = "Inicio";
    ViewData["Pestaña"] = "Inicio";
    List<Restricciones> restricciones = ViewBag.Restricciones;
    int? restriccionElegida = ViewBag.RestriccionElegida;
}

@section Estilos {
    <link rel="stylesheet" href="~/css/inicio.css" asp-append-version="true" />
}

<div class="inicio">
    <!-- Banner -->
    <section class="banner">
        <div class="banner-texto">
            <p class="banner-saludo">Hola, @ViewBag.PrimerNombre</p>
            <h1>¿Con quién salís esta semana?</h1>
            <p class="banner-descripcion">Armá un plan, sumá a tus amigos y votá el lugar entre todos.</p>
            <div class="banner-botones">
                <a class="boton boton-primario" href="/Planes/NuevoPlan">Crear un plan</a>
                <a class="boton boton-secundario" href="/Restaurantes/Descubrir">Explorar restaurantes</a>
            </div>
        </div>

        <div class="banner-resumen">
            <div class="dato">
                <img src="~/img/icono-calendario.svg" width="24" height="24" alt="" />
                <span class="dato-numero">@ViewBag.PlanesEnVotacion</span>
                <span class="dato-texto">@(ViewBag.PlanesEnVotacion == 1 ? "plan en votación" : "planes en votación")</span>
            </div>
            @* Las amistades no tienen tabla en la base: cuenta a quienes comparten algún grupo con el usuario *@
            <div class="dato">
                <img src="~/img/icono-usuarios-chico.svg" width="24" height="24" alt="" />
                <span class="dato-numero">@ViewBag.Amigos</span>
                <span class="dato-texto">@(ViewBag.Amigos == 1 ? "amigo" : "amigos")</span>
            </div>
        </div>
    </section>

    @* Cada chip es una restricción de la base: muestra los lugares que ofrecen esa opción *@
    <nav class="filtros-rapidos" aria-label="Filtrar por restricción">
        <a class="chip chip-filtro @(restriccionElegida == null ? "chip-activo" : "chip-crema")"
           href="/Home/Inicio" data-restriccion="" aria-current="@(restriccionElegida == null ? "true" : null)">Todos</a>
        @foreach (Restricciones opcion in restricciones)
        {
            <a class="chip chip-filtro @(restriccionElegida == opcion.Id ? "chip-activo" : "chip-crema")"
               href="/Home/Inicio?restriccion=@opcion.Id" data-restriccion="@opcion.Id" aria-current="@(restriccionElegida == opcion.Id ? "true" : null)">@opcion.Nombre</a>
        }
    </nav>

    @* Las dos grillas cambian con el chip elegido: inicio.js las vuelve a pedir a /Home/LugaresInicio sin recargar *@
    <div id="lugaresInicio">
        @await Html.PartialAsync("_LugaresInicio")
    </div>
</div>

@section Scripts {
    <script src="~/js/inicio.js" asp-append-version="true"></script>
}
